# ============================================================
# OAKG AAAI 2027 — only code (src/, notebooks/) and text configs
# are tracked. No PDFs, office docs, data, or large binaries.
# ============================================================

# --- Documents (never push) ---
docs/
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
*.odt

# --- Data & medical imaging volumes ---
data/
*.nii
*.nii.gz
*.dcm
*.mha
*.mhd
*.raw
*.h5
*.hdf5

# --- Model checkpoints & embeddings (regenerable / large) ---
# Ignore contents but keep the directory scaffolding (.gitkeep).
checkpoints/*
embeddings/*
*.pt
*.pth
*.ckpt
*.onnx
*.npz
*.npy
*.pkl
*.joblib

# --- Experiment outputs ---
*.csv
*.png
*.jpg
*.jpeg
*.svg
# Large raw per-query dumps: regenerable, kept out of git (multi-MB).
results/query_level/

# Keep only the .gitkeep scaffolding (NOT a blanket directory un-ignore, which
# would leak files from fully-ignored dirs like data/ and docs/).
!**/.gitkeep

# Track the small, reviewable results so the team can see them on GitHub
# (overrides the *.csv / *.png ignores above; all < ~150 KB).
!results/README.md
!results/config.json
!results/tables/*.csv
!results/figures/*.png
!results/strata/*.csv

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/
.python-version

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Claude Code local settings ---
.claude/

# Demo notebook outputs (keep real results/ intact)
results_demo/
